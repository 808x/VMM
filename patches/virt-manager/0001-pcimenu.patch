+class VMRedirectMenu(_VMMenu):
+    """Curated PCI redirect submenu; attached rows survive re-curation."""
+
+    def _init_state(self):
+        self._dev_items = {}
+        self._updating = False
+        self._pending_vm = None
+        self._err = pci_redirect.MenuErrorSink(self)
+
+        self._more_item = self._add_action(
+            _("_All devices"), "pci-more-devices",
+            lambda parent, ignore: parent.control_vm_pci_redirection(None))
+        self._separator = Gtk.SeparatorMenuItem()
+        self.insert(self._separator, 0)
+
+        self.get_accessible().set_name("vmm-pci-redirect-menu")
+        self.connect("unmap", self._menu_unmapped)
+        self.show_all()
+
+    def _make_item(self, vm, addr, xmlobj):
+        if xmlobj is not None:
+            label = pci_redirect.device_label(xmlobj)
+        else:  # pragma: no cover
+            label = pci_redirect.pci_addr_label(addr)
+
+        item = Gtk.CheckMenuItem(label=label)
+        item.set_tooltip_text(pci_redirect.device_tooltip(xmlobj, vm))
+        item.connect("toggled", self._device_toggled, vm, addr)
+        return item
+
+    def update_widget_states(self, vm):
+        if self._updating:
+            return
+
+        # Mutating a mapped popup does not relayout reliably.
+        if self.get_mapped():
+            self._pending_vm = vm
+            return
+
+        self._updating = True
+        try:
+            entries = {}
+            attached = set()
+
+            if vm:
+                attached = set(pci_redirect.state_pci_addrs(vm))
+                for dev in pci_redirect.list_redirectable_pci_devices(vm):
+                    entries[pci_redirect.nodedev_pci_addr(dev.xmlobj)] = \
+                        dev.xmlobj
+
+                # Keep attached devices visible so they can be turned off.
+                for addr in attached:
+                    if addr in entries:
+                        continue
+                    nodedev = pci_redirect.nodedev_from_addr(vm.conn, addr)
+                    entries[addr] = nodedev.xmlobj if nodedev else None
+
+            for addr, item in list(self._dev_items.items()):
+                if addr not in entries:
+                    self.remove(item)
+                    del self._dev_items[addr]
+
+            for addr, xmlobj in entries.items():
+                if addr not in self._dev_items:
+                    item = self._make_item(vm, addr, xmlobj)
+                    self._dev_items[addr] = item
+                    self.append(item)
+                    item.show()
+
+            desired = [self._dev_items[a]
+                       for a in sorted(entries, reverse=True)]
+            desired += [self._separator, self._more_item]
+            current = self.get_children()
+            for idx, item in enumerate(desired):
+                if idx >= len(current) or current[idx] is not item:
+                    self.reorder_child(item, idx)
+                    current = self.get_children()
+
+            for addr, item in self._dev_items.items():
+                active = addr in attached
+                if item.get_active() != active:
+                    item.set_active(active)
+                tip = pci_redirect.device_tooltip(entries[addr], vm)
+                if item.get_tooltip_text() != tip:
+                    item.set_tooltip_text(tip)
+
+            self._separator.set_visible(bool(self._dev_items))
+        finally:
+            self._updating = False
+
+    def _device_toggled(self, chk, vm, addr):
+        if self._updating:
+            return
+        pci_redirect.toggle_device(chk, vm, self._err, addr)
+        GLib.idle_add(self._refresh_idle, vm)
+
+    def _menu_unmapped(self, _menu):
+        self._err.flush()
+        if self._pending_vm is None:
+            return
+        vm = self._pending_vm
+        self._pending_vm = None
+        GLib.idle_add(self._refresh_idle, vm)
+
+    def _refresh_idle(self, vm):
+        self.update_widget_states(vm)
+        return False
+
