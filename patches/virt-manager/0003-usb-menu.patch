+class VMUsbRedirectMenu(_VMMenu):
+    """USB redirect submenu; rows are rebuilt from the spice manager."""
+
+    def _init_state(self):
+        self._dev_items = []
+        self._updating = False
+        self._pending = False
+        self._last_sig = None
+        self._err = usb_redirect.MenuErrorSink(self)
+
+        self._all_item = self._add_action(
+            _("_All devices"), "usb-all-devices",
+            lambda parent, ignore: parent.control_vm_usb_redirection(None))
+        self._separator = Gtk.SeparatorMenuItem()
+        self.insert(self._separator, 0)
+        self.connect("unmap", self._menu_unmapped)
+
+        self.get_accessible().set_name("vmm-usb-redirect-menu")
+        self.show_all()
+
+    def _get_manager(self):
+        console = getattr(self._parent, "_console", None)
+        if console is None:  # pragma: no cover
+            return None
+        try:
+            return console.vmwindow_viewer_get_usb_manager()
+        except Exception:  # pragma: no cover
+            log.debug("Error looking up spice USB manager", exc_info=True)
+            return None
+
+    def update_widget_states(self, vm):
+        if self._updating:
+            return
+
+        if self.get_mapped():
+            self._pending = True
+            return
+
+        self._updating = True
+        try:
+            manager = self._get_manager()
+            devices = usb_redirect.list_devices(manager)
+
+            sig = (id(manager),
+                   tuple((usb_redirect.menu_label(d),
+                          usb_redirect.is_connected(manager, d))
+                         for d in devices),
+                   bool(vm and vm.is_active()))
+            if sig == self._last_sig:
+                self._all_item.set_sensitive(sig[1])
+                self._separator.set_visible(bool(devices))
+                return
+            self._last_sig = sig
+
+            for item in self._dev_items:
+                self.remove(item)
+            self._dev_items = []
+
+            # Building the order directly avoids reorder_child() after the
+            # submenu is realized, which did not take effect.
+            self.remove(self._separator)
+            self.remove(self._all_item)
+
+            for dev in devices:
+                item = Gtk.CheckMenuItem(label=usb_redirect.menu_label(dev))
+                item.set_active(usb_redirect.is_connected(manager, dev))
+                item.set_tooltip_text(
+                    usb_redirect.device_tooltip(manager, dev))
+                item.connect("toggled", self._device_toggled, manager, dev)
+                self.add(item)
+                item.show()
+                self._dev_items.append(item)
+
+            self.add(self._separator)
+            self.add(self._all_item)
+            self._all_item.show()
+
+            self._all_item.set_sensitive(bool(vm and vm.is_active()))
+            self._separator.set_visible(bool(self._dev_items))
+        finally:
+            self._updating = False
+
+    def _device_toggled(self, chk, manager, dev):
+        if self._updating:
+            return
+        usb_redirect.toggle_device(chk, manager, self._err, dev)
+
+    def _menu_unmapped(self, _menu):
+        self._err.flush()
+        if not self._pending:
+            return
+        self._pending = False
+        self.update_widget_states(self._current_vm_cb())
+
