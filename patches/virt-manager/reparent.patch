+def _is_wayland():
+    display = Gdk.Display.get_default()
+    return bool(display and Gdk.Display.get_name(display).startswith("wayland"))
+
+
+def _has_qemu_gtk_display(vm):
+    """True when qemu:commandline passes -display gtk."""
+    try:
+        args = [arg.value for arg in vm.get_xmlobj().xmlns_qemu.args]
+    except Exception:
+        return False
+    for idx, arg in enumerate(args[:-1]):
+        if arg == "-display" and args[idx + 1].startswith("gtk"):
+            return True
+    return False
+
