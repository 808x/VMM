+/* Translate GDK touchpad pinch/swipe into virtio-multitouch slots. */
+static gboolean gd_touchpad_pinch_event(GtkWidget *widget,
+                                        GdkEvent *event, void *opaque)
+{
+    VirtualConsole *vc = opaque;
+    GdkEventTouchpadPinch *pinch = (GdkEventTouchpadPinch *)event;
+    Error *err = NULL;
+    int type;
+    double r, angle;
+    int i;
+
+    switch (pinch->phase) {
+    case GDK_TOUCHPAD_GESTURE_PHASE_BEGIN:
+        type = INPUT_MULTI_TOUCH_TYPE_BEGIN;
+        vc->gfx.tpad.active = true;
+        vc->gfx.tpad.cx = pinch->x;
+        vc->gfx.tpad.cy = pinch->y;
+        vc->gfx.tpad.base_r = 60.0;
+        vc->gfx.tpad.fingers = 2;
+        break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_UPDATE:
+        type = INPUT_MULTI_TOUCH_TYPE_UPDATE;
+        if (!vc->gfx.tpad.active) {
+            return FALSE;
+        }
+        /* Follow the drifting center as a two-finger pan. */
+        vc->gfx.tpad.cx += pinch->dx;
+        vc->gfx.tpad.cy += pinch->dy;
+        break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_END:
+    case GDK_TOUCHPAD_GESTURE_PHASE_CANCEL:
+        type = INPUT_MULTI_TOUCH_TYPE_END;
+        if (!vc->gfx.tpad.active) {
+            return FALSE;
+        }
+        vc->gfx.tpad.active = false;
+        break;
+    default:
+        return FALSE;
+    }
+
+    angle = 0.0;
+    r = vc->gfx.tpad.base_r * (type == INPUT_MULTI_TOUCH_TYPE_BEGIN
+                                   ? 1.0 : pinch->scale);
+    for (i = 0; i < vc->gfx.tpad.fingers; i++) {
+        double side = (i % 2 == 0) ? -1.0 : 1.0;
+        double px = vc->gfx.tpad.cx +
+                    side * r * cos(angle + M_PI_2 * (i / 2));
+        double py = vc->gfx.tpad.cy +
+                    side * r * sin(angle + M_PI_2 * (i / 2));
+        qemu_input_touch_event(vc->gfx.dcl.con, touch_slots, i,
+                               surface_width(vc->gfx.ds),
+                               surface_height(vc->gfx.ds),
+                               px, py, type, &err);
+        if (err) {
+            warn_report_err(err);
+            err = NULL;
+        }
+    }
+    return TRUE;
+}
+
+static gboolean gd_touchpad_swipe_event(GtkWidget *widget,
+                                        GdkEvent *event, void *opaque)
+{
+    VirtualConsole *vc = opaque;
+    GdkEventTouchpadSwipe *swipe = (GdkEventTouchpadSwipe *)event;
+    Error *err = NULL;
+    int type, n;
+    double spacing = 50.0;
+    int i;
+
+    switch (swipe->phase) {
+    case GDK_TOUCHPAD_GESTURE_PHASE_BEGIN:
+        type = INPUT_MULTI_TOUCH_TYPE_BEGIN;
+        vc->gfx.tpad.active = true;
+        vc->gfx.tpad.cx = swipe->x;
+        vc->gfx.tpad.cy = swipe->y;
+        n = swipe->n_fingers > 0 ? swipe->n_fingers : 3;
+        if (n > INPUT_EVENT_SLOTS_MAX) {
+            n = INPUT_EVENT_SLOTS_MAX;
+        }
+        vc->gfx.tpad.fingers = n;
+        break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_UPDATE:
+        type = INPUT_MULTI_TOUCH_TYPE_UPDATE;
+        if (!vc->gfx.tpad.active) {
+            return FALSE;
+        }
+        vc->gfx.tpad.cx += swipe->dx;
+        vc->gfx.tpad.cy += swipe->dy;
+        break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_END:
+    case GDK_TOUCHPAD_GESTURE_PHASE_CANCEL:
+        type = INPUT_MULTI_TOUCH_TYPE_END;
+        if (!vc->gfx.tpad.active) {
+            return FALSE;
+        }
+        vc->gfx.tpad.active = false;
+        break;
+    default:
+        return FALSE;
+    }
+
+    n = vc->gfx.tpad.fingers;
+    for (i = 0; i < n; i++) {
+        double px = vc->gfx.tpad.cx +
+                    ((i - (n - 1) / 2.0) * spacing);
+        double py = vc->gfx.tpad.cy;
+        qemu_input_touch_event(vc->gfx.dcl.con, touch_slots, i,
+                               surface_width(vc->gfx.ds),
+                               surface_height(vc->gfx.ds),
+                               px, py, type, &err);
+        if (err) {
+            warn_report_err(err);
+            err = NULL;
+        }
+    }
+    return TRUE;
+}
+
+/* GTK3 has no touchpad-gesture signal; use the generic event hook. */
+static gboolean gd_touchpad_event(GtkWidget *widget, GdkEvent *event,
+                                  void *opaque)
+{
+    switch (event->type) {
+    case GDK_TOUCHPAD_PINCH:
+        return gd_touchpad_pinch_event(widget, event, opaque);
+    case GDK_TOUCHPAD_SWIPE:
+        return gd_touchpad_swipe_event(widget, event, opaque);
+    default:
+        return FALSE;
+    }
+}
