+/* Focus-in on the QEMU toplevel or any embedder ancestor, provided the
+ * console is mapped. Used to trigger one forced re-blit. */
+static bool gd_egl_forced_draw;
+
+static bool gd_focused_visible(VirtualConsole *vc)
+{
+    GtkWidget *w = vc->window ? vc->window : vc->gfx.drawing_area;
+    GtkWindow *toplevel;
+    GdkWindow *gwin;
+    Display *dpy;
+    Window xwin, focus, parent, next_parent, root;
+    int revert_to = RevertToNone;
+    unsigned int nchildren;
+    Window *children = NULL;
+
+    if (!gtk_widget_get_mapped(w)) {
+        return false;
+    }
+    toplevel = GTK_WINDOW(gtk_widget_get_toplevel(w));
+    gwin = gtk_widget_get_window(GTK_WIDGET(toplevel));
+    if (!gwin) {
+        return false;
+    }
+    if (gtk_window_is_active(toplevel)) {
+        /* focus held inside our hierarchy (e.g. a GDK keyboard grab
+         * window); GTK tracks this as toplevel-active */
+        return true;
+    }
+    dpy = gdk_x11_display_get_xdisplay(gdk_window_get_display(gwin));
+    if (!dpy) {
+        return false;
+    }
+    xwin = gdk_x11_window_get_xid(gwin);
+    XGetInputFocus(dpy, &focus, &revert_to);
+    for (parent = xwin; parent != None; parent = next_parent) {
+        if (parent == focus) {
+            /* our toplevel or an embedder ancestor holds X focus */
+            return true;
+        }
+        if (!XQueryTree(dpy, parent, &root, &next_parent,
+                        &children, &nchildren)) {
+            break;
+        }
+        if (children) {
+            XFree(children);
+            children = NULL;
+        }
+        if (parent == root) {
+            break;
+        }
+    }
+    return false;
+}
