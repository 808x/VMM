+/* GDK's viewable flag is stale until UnmapNotify is processed; ask the
+ * server so a swap cannot hit an already-unmapped window (DRI3/Present
+ * would block forever). */
+static gboolean gd_egl_window_server_viewable(GdkWindow *window)
+{
+    Display *xdisp;
+    XWindowAttributes xa;
+
+    xdisp = (Display *)gdk_x11_display_get_xdisplay(gdk_window_get_display(window));
+    if (!xdisp) {
+        return FALSE;
+    }
+    if (!XGetWindowAttributes(xdisp, gdk_x11_window_get_xid(window), &xa)) {
+        return FALSE;
+    }
+    return xa.map_state == IsViewable;
+}
+
+/* Hidden means gone, GDK-unviewable, or server-unviewable. */
+static gboolean gd_egl_window_hidden(GdkWindow *window)
+{
+    if (!window || !gdk_window_is_viewable(window)) {
+        return TRUE;
+    }
+    return !gd_egl_window_server_viewable(window);
+}
