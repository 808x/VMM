+/* A lost dmabuf fence leaves gl_block set forever; force it clear. */
+static void console_hw_gl_force_unblock_timer(void *opaque)
+{
+    QemuConsole *con = opaque;
+
+    if (con->gl_block <= 0) {
+        return;
+    }
+    error_report("console: gl-block stuck for 3s (%d pending), forcing unblock",
+                 con->gl_block);
+    con->gl_block = 0;
+    if (con->hw_ops->gl_block) {
+        con->hw_ops->gl_block(con->hw, false);
+    }
+}
+
 void qemu_console_hw_gl_block(QemuConsole *con, bool block)
 {
     uint64_t timeout;
@@ -204,8 +220,17 @@ void qemu_console_hw_gl_block(QemuConsole *con, bool block)
         timeout = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
         timeout += 1000; /* one sec */
         timer_mod(con->gl_unblock_timer, timeout);
+        /* Arm once per burst; nested blocks keep the outermost deadline. */
+        if (con->gl_block == 1) {
+            timeout = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+            timeout += 3000;
+            timer_mod(con->gl_force_unblock_timer, timeout);
+        }
     } else {
         timer_del(con->gl_unblock_timer);
+        if (con->gl_block == 0) {
+            timer_del(con->gl_force_unblock_timer);
+        }
     }
 }
 
