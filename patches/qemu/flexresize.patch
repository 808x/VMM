+/* GTK window resize -> SVGA display topology + Resolution_Set. */
+static void vmsvga_ui_info(void *opaque, uint32_t idx, QemuUIInfo *info)
+{
+    struct vmsvga_state_s *s = opaque;
+    char *msg;
+
+    if (idx != 0 || info == NULL || info->width == 0 || info->height == 0) {
+        return;
+    }
+
+    s->disp_prim = 1;
+    s->disp_x = 0;
+    s->disp_y = 0;
+    s->disp_width = info->width;
+    s->disp_height = info->height;
+    s->reso_wanted_width = info->width;
+    s->reso_wanted_height = info->height;
+    s->reso_sends = 0;
+    s->reso_last_send_ms = 0; /* send on the next display tick */
+
+    if (s->enable && s->active_width != 0 && s->active_height != 0) {
+        vmsvga_damage_add(s, 0, 0, s->active_width, s->active_height);
+    }
+
+    /* Windows Tools applies Resolution_Set on the TCLO channel;
+     * DisplayTopology_Set is the fallback for older tools. */
+    msg = g_strdup_printf("Resolution_Set %u %u", info->width, info->height);
+    vmport_guestrpc_send_to_tclo(msg);
+    g_free(msg);
+    msg = g_strdup_printf("DisplayTopology_Set 1 , 0 0 %u %u",
+                          info->width, info->height);
+    vmport_guestrpc_send_to_guest(msg);
+    g_free(msg);
+}
