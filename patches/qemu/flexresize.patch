+static bool vmport_guestrpc_send_to_proto(const char *msg, bool tclo);
+
+/* RPCI send: copy and deliver on the next idle RECVSIZE poll. */
+bool vmport_guestrpc_send_to_guest(const char *msg)
+{
+    return vmport_guestrpc_send_to_proto(msg, false);
+}
+
+/* TCLO (toolbox) send; the guest replies "OK ..." via its send path. */
+bool vmport_guestrpc_send_to_tclo(const char *msg)
+{
+    return vmport_guestrpc_send_to_proto(msg, true);
+}
+
+static bool vmport_guestrpc_send_to_proto(const char *msg, bool tclo)
+{
+    VMPortState *s = port_state;
+
+    if (s != NULL && vmport_guestrpc_debug_enabled(s)) {
+        fprintf(stderr, "vmport-guestrpc: send_to_%s '%s'\n",
+                tclo ? "tclo" : "guest", msg);
+    }
+    if (s == NULL || msg == NULL || *msg == '\0') {
+        return false;
+    }
+    if (tclo) {
+        g_free(s->pending_tclo_msg);
+        s->pending_tclo_msg = g_strdup(msg);
+    } else {
+        g_free(s->pending_guestmsg);
+        s->pending_guestmsg = g_strdup(msg);
+    }
+    return true;
+}
