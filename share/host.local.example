# Copy to share/host.local and edit.  Key=value lines are substituted into
# the examples by ./install.sh --writexml.  Everything here is optional.
#
# DISK=/var/lib/libvirt/images/cachyos.qcow2
# NVRAM=/var/lib/libvirt/qemu/nvram
# OVMF_CODE=/path/to/OVMF_CODE_4M.fd
# OVMF_VARS=/path/to/OVMF_VARS_4M.fd
# OVMF_CODE_MS=/path/to/OVMF_CODE_4M.ms.fd
# OVMF_VARS_MS=/path/to/OVMF_VARS_4M.ms.fd
#
# Hostdevs, PCI addresses and USB redirection stay out of the examples.
# Add them with virt-manager or virsh edit after defining a domain.
